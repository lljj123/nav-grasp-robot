<?xml version="1.0"?>
<package format="3">
  <name>visual_grasp_motion</name>
  <version>0.1.0</version>
  <description>Guarded grasp planning and two-stage PiPER execution.</description>
  <maintainer email="nav-grasp@users.noreply.github.com">Nav-Grasp Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>agx_arm_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visual_grasp_interfaces</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

