# Copy this file to config/project.env and use absolute paths for local drivers.
# The copied file is intentionally ignored by Git.

ROS_DISTRO=humble

# Optional overlays for vendor packages that are not installed system-wide.
BASE_DRIVER_SETUP=/absolute/path/to/base_driver_ws/install/setup.bash
LIDAR_DRIVER_SETUP=/absolute/path/to/lidar_driver_ws/install/setup.bash
ROBOT_MODEL_SETUP=/absolute/path/to/robot_model_ws/install/setup.bash
ARM_DRIVER_SETUP=/absolute/path/to/arm_driver_ws/install/setup.bash
ARM_DRIVER_WS=/absolute/path/to/arm_driver_ws

# Hardware lifecycle scripts used by the one-command launcher.
ARM_CONTROL_SCRIPT=/absolute/path/to/start_arm_control.sh
CAMERA_START_SCRIPT=/absolute/path/to/start_camera.sh
CAMERA_STOP_SCRIPT=/absolute/path/to/stop_camera.sh
CAN_SETUP_SCRIPT=/absolute/path/to/activate_can.sh

# Standard-interface examples. Detect and test the actual SocketCAN interface
# on this computer before setting BASE_CAN_INTERFACE and BASE_CAN_BITRATE.
BASE_CAN_INTERFACE=can1
BASE_CAN_BITRATE=500000
# BASE_LIDAR_LAUNCH=/absolute/path/to/custom_base_lidar.launch.py
LIDAR_CLOUD_TOPIC=/livox/lidar
LIDAR_FRAME=livox_frame
CAMERA_IMAGE_TOPIC=/camera/camera/color/image_raw

# Runtime data that is specific to one robot and one site.
NAV_GRASP_MAP=/absolute/path/to/map.yaml
NAV_GRASP_MISSION_CONFIG=/absolute/path/to/mission.local.yaml
NAV_GRASP_CALIBRATION_DIR=/absolute/path/to/calibration
NAV_GRASP_GRIPPER_REPORT=/absolute/path/to/manual_gripper_range.json
