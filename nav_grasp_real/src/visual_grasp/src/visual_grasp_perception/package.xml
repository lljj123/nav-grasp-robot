<?xml version="1.0"?>
<package format="3">
  <name>visual_grasp_perception</name>
  <version>0.1.0</version>
  <description>Traditional RGB-D detection of red, green, and blue 30 mm cubes.</description>
  <maintainer email="nav-grasp@users.noreply.github.com">Nav-Grasp Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visual_grasp_calibration</exec_depend>
  <exec_depend>visual_grasp_interfaces</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

