<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tracer_piper_mobile_manipulator">
  <xacro:arg
    name="initial_positions_file"
    default="$(find tracer_gazebo_sim)/config/piper_initial_positions.yaml"/>
  <xacro:arg
    name="controllers_file"
    default="$(find tracer_gazebo_sim)/config/piper_controllers.yaml"/>

  <xacro:property
    name="initial_positions"
    value="${xacro.load_yaml('$(arg initial_positions_file)')['initial_positions']}"/>

  <!-- 原有 TRACER 底盘、MID-360、IMU 和 DiffDrive 插件。 -->
  <xacro:include filename="$(find tracer_gazebo_sim)/urdf/tracer.urdf.xacro"/>

  <!-- 车体后半部的工控机；旧的车载放置托盘已移除。 -->
  <xacro:include filename="$(find tracer_gazebo_sim)/urdf/tracer_rear_payload.xacro"/>
  <xacro:tracer_rear_payload parent="base_link"/>

  <!-- 带 piper_ 前缀的机械臂、夹爪和腕部 D435。 -->
  <xacro:include filename="$(find tracer_gazebo_sim)/urdf/piper_mobile_arm.xacro"/>
  <xacro:piper_mobile_arm parent="livox_frame"/>

  <ros2_control name="PiperMobileGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="piper_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['piper_joint1']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['piper_joint2']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['piper_joint3']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['piper_joint4']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['piper_joint5']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_joint6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['piper_joint6']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_gripper_joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['piper_gripper_joint1']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="piper_gripper_joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_positions['piper_gripper_joint2']}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Match the Gazebo IMU sensor so gz_ros2_control does not report it as
         missing from hardware_info.  The ROS IMU topic is still bridged
         directly from Gazebo; no extra broadcaster is required. -->
    <sensor name="imu_sensor">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
  </ros2_control>

  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <hold_joints>true</hold_joints>
      <position_proportional_gain>0.1</position_proportional_gain>
    </plugin>
  </gazebo>
</robot>
