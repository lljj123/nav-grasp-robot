<?xml version="1.0"?>
<!-- Prefixed Piper arm for the TRACER mobile-manipulator model. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_mobile_arm">
  <xacro:include
    filename="$(find piper_vision_gazebo)/urdf/piper_d435_fortress_description.xacro"/>
  <xacro:macro
    name="piper_mesh_link"
    params="link_name mesh_name mass com ixx ixy ixz iyy iyz izz">
    <link name="${link_name}">
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
          iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/${mesh_name}.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/${mesh_name}.stl"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="piper_mobile_arm" params="parent">
    <!--
      MID-360 顶面约为 livox_frame + 0.03 m。安装柱从 +0.04 m 开始，
      Piper 基座原点位于 livox_frame + 0.12 m，与雷达中心保持同轴。
    -->
    <link name="piper_mount_link">
      <inertial>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <mass value="0.60"/>
        <inertia
          ixx="0.001164" ixy="0" ixz="0"
          iyy="0.001164" iyz="0" izz="0.001688"/>
      </inertial>
      <visual name="piper_mount_visual">
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry><cylinder radius="0.075" length="0.08"/></geometry>
        <material name="piper_mount_dark">
          <color rgba="0.10 0.11 0.12 1"/>
        </material>
      </visual>
      <collision name="piper_mount_collision">
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry><cylinder radius="0.075" length="0.08"/></geometry>
      </collision>
    </link>

    <joint name="piper_livox_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="piper_mount_link"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_base_link" mesh_name="base_link" mass="1.02"
      com="-0.00473641164191482 2.56829134630247E-05 0.041451518036016"
      ixx="0.00267433" ixy="-0.00000073" ixz="-0.00017389"
      iyy="0.00282612" iyz="0.0000004" izz="0.00089624"/>

    <joint name="piper_mount_to_base_joint" type="fixed">
      <parent link="piper_mount_link"/>
      <child link="piper_base_link"/>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_link1" mesh_name="link1" mass="0.71"
      com="0.00032 -0.00041 -0.00348"
      ixx="0.00050027" ixy="0.00000078" ixz="0.00000626"
      iyy="0.00040879" iyz="0.00000462" izz="0.00045802"/>
    <joint name="piper_joint1" type="revolute">
      <origin xyz="0 0 0.123" rpy="0 0 0"/>
      <parent link="piper_base_link"/>
      <child link="piper_link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_link2" mesh_name="link2" mass="1.16"
      com="0.21852 -0.00861 0.00126"
      ixx="0.00111915" ixy="0.00182916" ixz="0.00019233"
      iyy="0.06763251" iyz="0.00000767" izz="0.067559"/>
    <joint name="piper_joint2" type="revolute">
      <origin xyz="0 0 0" rpy="1.5707963 -0.1357866 -3.1415926"/>
      <parent link="piper_link1"/>
      <child link="piper_link2"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_link3" mesh_name="link3" mass="0.5"
      com="-0.01999 -0.14808 -0.00053"
      ixx="0.01347608" ixy="0.00161034" ixz="0.00000066"
      iyy="0.00046377" iyz="0.00000162" izz="0.01363321"/>
    <joint name="piper_joint3" type="revolute">
      <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/>
      <parent link="piper_link2"/>
      <child link="piper_link3"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_link4" mesh_name="link4" mass="0.38"
      com="0.00013 -0.00076 -0.00394"
      ixx="0.00017844" ixy="0.00000062" ixz="0.00000067"
      iyy="0.00018914" iyz="0.00000408" izz="0.00014613"/>
    <joint name="piper_joint4" type="revolute">
      <origin xyz="-0.02198 -0.25075 0" rpy="1.5707963 0 0"/>
      <parent link="piper_link3"/>
      <child link="piper_link4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.7453292" upper="1.7453292" effort="100" velocity="5"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_link5" mesh_name="link5" mass="0.383"
      com="0.00018 -0.06104 -0.00227"
      ixx="0.00172318" ixy="0.00000259" ixz="0.00000010"
      iyy="0.00017936" iyz="0.00000990" izz="0.00171172"/>
    <joint name="piper_joint5" type="revolute">
      <origin xyz="0 0 0" rpy="-1.5707963 0 0"/>
      <parent link="piper_link4"/>
      <child link="piper_link5"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.2217304" upper="1.2217304" effort="100" velocity="5"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_link6" mesh_name="link6" mass="0.007"
      com="-0.00003 0.00006 -0.002"
      ixx="0.00152112" ixy="0.00000202" ixz="0.00000261"
      iyy="0.00138626" iyz="0.00000002" izz="0.00031152"/>
    <joint name="piper_joint6" type="revolute">
      <origin xyz="8.8259E-05 -0.091 0" rpy="1.5707963 0 0"/>
      <parent link="piper_link5"/>
      <child link="piper_link6"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_flange_link" mesh_name="flange" mass="0.04"
      com="1.151691e-03 0.782428e-03 4.798051e-03"
      ixx="9.935389e-06" ixy="0" ixz="0"
      iyy="10.508003e-06" iyz="0" izz="19.652873e-06"/>
    <joint name="piper_flange_joint" type="fixed">
      <parent link="piper_link6"/>
      <child link="piper_flange_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_gripper_base" mesh_name="gripper_base" mass="0.45"
      com="-0.000183807162235591 8.05033155577911E-05 0.0321436689908876"
      ixx="0.00092934" ixy="0.00000034" ixz="-0.00000738"
      iyy="0.00071447" iyz="0.00000005" izz="0.00039442"/>
    <joint name="piper_gripper_base_joint" type="fixed">
      <parent link="piper_flange_link"/>
      <child link="piper_gripper_base"/>
      <origin xyz="0 0 0.0045" rpy="0 0 0"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_gripper_link1" mesh_name="gripper_link1" mass="0.025"
      com="0.00065123185041968 -0.0491929869131989 0.00972258769184025"
      ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021"
      iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    <joint name="piper_gripper_joint1" type="prismatic">
      <origin xyz="0 0 0.138" rpy="1.5707963 0 0"/>
      <parent link="piper_gripper_base"/>
      <child link="piper_gripper_link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0.05" effort="10" velocity="3"/>
    </joint>

    <xacro:piper_mesh_link
      link_name="piper_gripper_link2" mesh_name="gripper_link2" mass="0.025"
      com="0.00065123185041968 -0.0491929869131989 0.00972258769184025"
      ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021"
      iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    <joint name="piper_gripper_joint2" type="prismatic">
      <origin xyz="0 0 0.138" rpy="1.5707963 0 -3.1415926"/>
      <parent link="piper_gripper_base"/>
      <child link="piper_gripper_link2"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.05" upper="0" effort="10" velocity="3"/>
    </joint>

    <xacro:piper_wrist_d435 parent="piper_gripper_base" name="wrist_camera"/>

    <gazebo reference="piper_gripper_link1">
      <mu1>2.5</mu1><mu2>2.5</mu2><kp>1000000.0</kp><kd>50.0</kd>
    </gazebo>
    <gazebo reference="piper_gripper_link2">
      <mu1>2.5</mu1><mu2>2.5</mu2><kp>1000000.0</kp><kd>50.0</kd>
    </gazebo>
  </xacro:macro>
</robot>
