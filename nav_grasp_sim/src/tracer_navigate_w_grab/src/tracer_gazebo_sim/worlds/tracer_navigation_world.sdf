<?xml version="1.0"?>
<sdf version="1.9">
  <world name="tracer_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.68 0.68 0.68 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


        <!-- 10 m × 10 m 围墙：高 1 m，厚 0.2 m -->
    <model name="boundary_walls">
      <static>true</static>

      <!-- 北墙 -->
      <link name="north_wall">
        <pose>0 5.1 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>10.4 0.2 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10.4 0.2 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.82 0.82 0.82 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 南墙 -->
      <link name="south_wall">
        <pose>0 -5.1 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>10.4 0.2 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10.4 0.2 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.82 0.82 0.82 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 东墙 -->
      <link name="east_wall">
        <pose>5.1 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.82 0.82 0.82 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 西墙 -->
      <link name="west_wall">
        <pose>-5.1 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.82 0.82 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple landmarks make /scan immediately visible in RViz. -->
    <model name="box_front">
      <static>true</static>
      <pose>3.0 0.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 5.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 5.0  1.0</size></box></geometry>
          <material><ambient>0.75 0.22 0.12 1</ambient><diffuse>0.75 0.22 0.12 1 </diffuse></material>
        </visual>
      </link>
    </model>


  <model name="box_left">
      <static>true</static>
      <pose>0.5 3.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.25 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.25 0.7</size></box></geometry>
          <material><ambient>0.15 0.45 0.18 1</ambient><diffuse>0.15 0.45 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>



        <model name="box_back">
      <static>true</static>
      <pose>-2.0 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 5.0  1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 5.0 1.0</size></box></geometry>
          <material><ambient>0.75 0.22 0.12 1</ambient><diffuse>0.75 0.22 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>



    <model name="box_right">
      <static>true</static>
      <pose>0.5 -3.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.25 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3.0 0.25 0.7</size></box></geometry>
          <material><ambient>0.15 0.45 0.18 1</ambient><diffuse>0.15 0.45 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- =========================================================
         右下角白色台面
         尺寸：长 0.4 m、宽 0.2 m、高 0.1 m
         位置：右下角 x > 0、y < 0
         ========================================================= -->
    <model name="white_platform">
      <static>true</static>

      <!-- 台面模型中心 -->
      <pose>4.0 -4.0 0 0 0 0</pose>

      <link name="platform_link">
        <!-- 高度0.1m，因此中心高度为0.05m -->
        <pose>0 0 0.15 0 0 0</pose>

        <collision name="platform_collision">
          <geometry>
            <box>
              <size>0.4 0.2 0.3</size>
            </box>
          </geometry>
        </collision>

        <visual name="platform_visual">
          <geometry>
            <box>
              <size>0.4 0.2 0.3</size>
            </box>
          </geometry>

          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>

    </model>

    <!-- Independent dynamic cubes.  They must not be links of the static
         platform or Gazebo will never allow the gripper to lift them. -->
    <model name="grasp_cube_red">
      <static>false</static>
      <self_collide>false</self_collide>
      <pose>3.9 -4.0 0.326 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0000333333</ixx><iyy>0.0000333333</iyy><izz>0.0000333333</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <velocity_decay><linear>0.02</linear><angular>0.02</angular></velocity_decay>
        <collision name="cube_collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
            <contact><ode><kp>1000000</kp><kd>50</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="cube_visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.8 0.02 0.02 1</ambient><diffuse>1.0 0.03 0.03 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="grasp_cube_green">
      <static>false</static>
      <self_collide>false</self_collide>
      <pose>4.1 -4.0 0.326 0 0 0</pose>
      <link name="cube_link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0000333333</ixx><iyy>0.0000333333</iyy><izz>0.0000333333</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <velocity_decay><linear>0.02</linear><angular>0.02</angular></velocity_decay>
        <collision name="cube_collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
            <contact><ode><kp>1000000</kp><kd>50</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="cube_visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.02 0.65 0.04 1</ambient><diffuse>0.03 0.9 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>


    <!-- =========================================================
         右上角储物筐
         外部尺寸：长0.5m、宽0.5m、高0.1m
         内部尺寸：长0.47m、宽0.47m、深0.09m
         侧壁厚0.015m，底板厚0.01m
         位置：x=-4.0m、y=4.0m，模型原点与底部高度保持不变
         采用底板加四面侧壁构成，上方开放
         ========================================================= -->
    <model name="storage_basket">
      <static>true</static>

      <pose>-4.0 4.0 0 0 0 0</pose>

      <!-- 储物筐底板 -->
      <link name="basket_bottom">
        <pose>0 0 0.005 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.01</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.01</size>
            </box>
          </geometry>

<material>
  <ambient>0.015 0.035 0.12 1</ambient>
  <diffuse>0.025 0.08 0.30 1</diffuse>
  <specular>0.12 0.12 0.18 1</specular>
</material>
        </visual>
      </link>

      <!-- 储物筐右侧壁 -->
      <link name="basket_right_wall">
        <pose>0.2425 0 0.05 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.015 0.5 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.015 0.5 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.55 0.55 0.60 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 储物筐左侧壁 -->
      <link name="basket_left_wall">
        <pose>-0.2425 0 0.05 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.015 0.5 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.015 0.5 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.55 0.55 0.60 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 储物筐前侧壁 -->
      <link name="basket_front_wall">
        <pose>0 -0.2425 0.05 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.47 0.015 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.47 0.015 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.55 0.55 0.60 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- 储物筐后侧壁 -->
      <link name="basket_back_wall">
        <pose>0 0.2425 0.05 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.47 0.015 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.47 0.015 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.55 0.55 0.60 1</diffuse>
          </material>
        </visual>
      </link>
    </model>







  </world>
</sdf>
