<?xml version="1.0"?>
<package format="3">
  <name>lidar</name>
  <version>0.1.0</version>
  <description>Configurable PointCloud2 to LaserScan bringup with a Livox default profile.</description>
  <maintainer email="nav-grasp@users.noreply.github.com">Nav-Grasp Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
