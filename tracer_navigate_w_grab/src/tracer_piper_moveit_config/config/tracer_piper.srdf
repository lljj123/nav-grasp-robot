<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic model for the prefixed Piper mounted on the TRACER chassis. -->
<robot name="tracer_piper_mobile_manipulator">
  <!-- The chassis is localized in map; the arm group itself remains fixed to it. -->
  <virtual_joint name="map_to_mobile_base" type="fixed" parent_frame="map" child_link="base_footprint"/>
  <group name="piper_arm">
    <chain base_link="piper_base_link" tip_link="piper_gripper_base"/>
  </group>

  <group name="piper_gripper">
    <joint name="piper_gripper_joint1"/>
    <joint name="piper_gripper_joint2"/>
  </group>

  <group_state name="camera_down" group="piper_arm">
    <joint name="piper_joint1" value="0.072925"/>
    <joint name="piper_joint2" value="0.806721"/>
    <joint name="piper_joint3" value="-0.927252"/>
    <joint name="piper_joint4" value="-0.004518"/>
    <joint name="piper_joint5" value="1.150000"/>
    <joint name="piper_joint6" value="-0.026715"/>
  </group_state>

  <group_state name="home" group="piper_arm">
    <joint name="piper_joint1" value="0.0"/>
    <joint name="piper_joint2" value="1.2"/>
    <joint name="piper_joint3" value="-1.2"/>
    <joint name="piper_joint4" value="0.0"/>
    <joint name="piper_joint5" value="0.0"/>
    <joint name="piper_joint6" value="0.0"/>
  </group_state>

  <group_state name="open" group="piper_gripper">
    <joint name="piper_gripper_joint1" value="0.04"/>
    <joint name="piper_gripper_joint2" value="-0.04"/>
  </group_state>

  <group_state name="closed" group="piper_gripper">
    <joint name="piper_gripper_joint1" value="0.0"/>
    <joint name="piper_gripper_joint2" value="0.0"/>
  </group_state>

  <end_effector
    name="piper_gripper"
    parent_link="piper_gripper_base"
    parent_group="piper_arm"
    group="piper_gripper"/>

  <!-- Chassis links that are physically joined or intentionally overlap. -->
  <disable_collisions link1="base_link" link2="left_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_left_caster_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_right_caster_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_left_caster_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_right_caster_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="imu_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="livox_frame" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="industrial_pc_link" reason="Adjacent"/>
  <disable_collisions link1="livox_frame" link2="piper_mount_link" reason="Adjacent"/>
  <disable_collisions link1="piper_mount_link" link2="piper_base_link" reason="Adjacent"/>

  <!-- Piper arm adjacency matrix. -->
  <disable_collisions link1="piper_base_link" link2="piper_link1" reason="Adjacent"/>
  <disable_collisions link1="piper_link1" link2="piper_link2" reason="Adjacent"/>
  <disable_collisions link1="piper_link2" link2="piper_link3" reason="Adjacent"/>
  <disable_collisions link1="piper_link3" link2="piper_link4" reason="Adjacent"/>
  <disable_collisions link1="piper_link4" link2="piper_link5" reason="Adjacent"/>
  <disable_collisions link1="piper_link5" link2="piper_link6" reason="Adjacent"/>
  <disable_collisions link1="piper_link6" link2="piper_flange_link" reason="Adjacent"/>
  <disable_collisions link1="piper_flange_link" link2="piper_gripper_base" reason="Adjacent"/>
  <disable_collisions link1="piper_gripper_base" link2="piper_gripper_link1" reason="Adjacent"/>
  <disable_collisions link1="piper_gripper_base" link2="piper_gripper_link2" reason="Adjacent"/>
  <disable_collisions link1="piper_gripper_link1" link2="piper_gripper_link2" reason="Default"/>
  <disable_collisions link1="piper_gripper_base" link2="wrist_camera_mount_link" reason="Mounted"/>
  <disable_collisions link1="wrist_camera_mount_link" link2="wrist_camera_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_camera_link" link2="wrist_camera_appearance_link" reason="Adjacent"/>
</robot>
