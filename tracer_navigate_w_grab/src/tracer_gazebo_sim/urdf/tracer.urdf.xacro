<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tracer_2_0">

  <!-- TRACER 2.0 main dimensions (metres), based on the 2025 user manual. -->
  <xacro:property name="body_length" value="0.702"/>
  <xacro:property name="body_width" value="0.610"/>
  <xacro:property name="body_height" value="0.135"/>
  <xacro:property name="body_z" value="0.105"/>
  <xacro:property name="wheel_separation" value="0.5174"/>
  <xacro:property name="wheel_radius" value="0.0605"/>
  <xacro:property name="wheel_width" value="0.0844"/>
  <!-- xacro already provides the global mathematical constant "pi". -->

  <material name="tracer_blue">
    <color rgba="0.055 0.22 0.42 1.0"/>
  </material>
  <material name="tracer_dark">
    <color rgba="0.035 0.045 0.055 1.0"/>
  </material>
  <material name="tracer_grey">
    <color rgba="0.28 0.31 0.34 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.02 0.02 0.025 1.0"/>
  </material>
  <material name="lamp_white">
    <color rgba="0.85 0.92 1.0 1.0"/>
  </material>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia_y" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3*radius*radius + length*length) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * radius*radius / 2.0}" iyz="0"
        izz="${mass * (3*radius*radius + length*length) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <!--
      Official AgileX TRACER 2.0 complete appearance mesh.  Its native axes are
      converted from DAE Z-up to ROS X-forward / Z-up and its bottom is aligned
      with the ground plane.  Collision remains a primitive for stable physics.
    -->
    <visual name="official_tracer_body">
      <origin xyz="0 0 0.0335" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <mesh filename="package://tracer_gazebo_sim/meshes/tracer_base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="43.0" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${body_z}"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side sign">
    <link name="${side}_wheel_link">
      <!-- Wheels are already part of the official complete visual mesh. -->
      <collision>
        <origin rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia_y mass="3.0" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${sign * wheel_separation/2.0} ${wheel_radius - body_z}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" sign="1"/>
  <xacro:drive_wheel side="right" sign="-1"/>

  <!-- Low-friction support balls approximate the four passive caster assemblies. -->
  <xacro:macro name="support_caster" params="name x y">
    <link name="${name}_caster_link">
      <!-- Caster appearance is already part of the official complete mesh. -->
      <collision>
        <geometry>
          <sphere radius="0.038"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.000087" ixy="0" ixz="0" iyy="0.000087" iyz="0" izz="0.000087"/>
      </inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} ${y} ${0.038 - body_z}"/>
    </joint>
  </xacro:macro>

  <xacro:support_caster name="front_left" x="0.255" y="0.190"/>
  <xacro:support_caster name="front_right" x="0.255" y="-0.190"/>
  <xacro:support_caster name="rear_left" x="-0.255" y="0.190"/>
  <xacro:support_caster name="rear_right" x="-0.255" y="-0.190"/>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.045 0.035 0.015"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.045 0.035 0.015"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="0.05" x="0.045" y="0.035" z="0.015"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.078"/>
  </joint>

<link name="livox_frame">

  <!-- MID-360下部机身 -->
  <visual name="livox_body">
    <origin xyz="0 0 -0.0075" rpy="0 0 0"/>
    <geometry>
      <box size="0.065 0.065 0.045"/>
    </geometry>
    <material name="livox_grey">
      <color rgba="0.32 0.34 0.36 1.0"/>
    </material>
  </visual>

  <!-- MID-360上部扫描窗口 -->
  <visual name="livox_window">
    <origin xyz="0 0 0.0225" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.0275" length="0.015"/>
    </geometry>
    <material name="livox_black">
      <color rgba="0.025 0.025 0.030 1.0"/>
    </material>
  </visual>

  <!-- 使用简单碰撞体，避免高精度网格影响仿真性能 -->
  <collision>
    <geometry>
      <box size="0.065 0.065 0.060"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.265"/>
    <inertia
      ixx="0.000173"
      ixy="0.0"
      ixz="0.0"
      iyy="0.000173"
      iyz="0.0"
      izz="0.000187"/>
  </inertial>

</link>




<!-- 雷达安装在TRACER车体顶部 -->
<joint name="livox_joint" type="fixed">
  <parent link="base_link"/>
  <child link="livox_frame"/>

  <!--
    x：前后位置
    y：左右位置
    z：相对base_link的安装高度
  -->
  <origin xyz="0.15 0 0.10" rpy="0 0 0"/>
</joint>

  <gazebo reference="left_wheel_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
  </gazebo>
  <gazebo reference="front_left_caster_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  <gazebo reference="front_right_caster_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  <gazebo reference="rear_left_caster_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  <gazebo reference="rear_right_caster_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>



<!-- ========================================================= -->
<!-- Gazebo MID-360传感器                                      -->
<!-- ========================================================= -->

<gazebo reference="livox_frame">

  <!-- 三维MID-360点云 -->
  <sensor name="livox_mid360" type="gpu_lidar">

    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>10</update_rate>

    <!-- Gazebo会额外发布 /livox/lidar/points -->
    <topic>/livox/lidar</topic>

    <gz_frame_id>livox_frame</gz_frame_id>

    <ray>

      <scan>

        <!-- 360°水平视场 -->
        <horizontal>
          <samples>500</samples>
          <resolution>1</resolution>
          <min_angle>-${pi}</min_angle>
          <max_angle>${pi}</max_angle>
        </horizontal>

        <!-- MID-360垂直视场：-7°到52° -->
        <vertical>
          <samples>40</samples>
          <resolution>1</resolution>
          <min_angle>-0.122173</min_angle>
          <max_angle>0.907571</max_angle>
        </vertical>

      </scan>

      <range>
        <min>0.10</min>
        <max>70.0</max>
        <resolution>0.02</resolution>
      </range>

      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.02</stddev>
      </noise>

    </ray>

  </sensor>


  <!--
    Nav2和SLAM Toolbox需要sensor_msgs/LaserScan。
    这是从MID-360位置发出的虚拟水平扫描切片。
  -->
  <sensor name="livox_nav_slice" type="gpu_lidar">

    <always_on>true</always_on>
    <visualize>false</visualize>
    <update_rate>10</update_rate>

    <topic>/scan</topic>
    <gz_frame_id>livox_frame</gz_frame_id>

    <ray>

      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-${pi}</min_angle>
          <max_angle>${pi}</max_angle>
        </horizontal>
      </scan>

      <range>
        <!--
          The 2-D navigation slice must not report the mobile manipulator
          itself.  The rear industrial PC is 0.23 to 0.49 m from this sensor
          and previously produced a solid 70-degree arc in /scan.  Those
          returns were written into both Nav2 costmaps and moved with the
          robot, repeatedly triggering clear/spin recoveries.

          0.50 m is just outside the complete TRACER + rear-payload envelope.
          The separate 3-D MID-360 point cloud keeps its original 0.10 m
          minimum range for perception work.
        -->
        <min>0.50</min>
        <max>40.0</max>
        <resolution>0.01</resolution>
      </range>

      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.01</stddev>
      </noise>

    </ray>

  </sensor>

</gazebo>


<gazebo>
  <plugin
    filename="gz-sim-diff-drive-system"
    name="gz::sim::systems::DiffDrive">

    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>

    <wheel_separation>${wheel_separation}</wheel_separation>
    <wheel_radius>${wheel_radius}</wheel_radius>

    <topic>/cmd_vel</topic>
    <odom_topic>/wheel/odom</odom_topic>
    <tf_topic>/wheel/tf</tf_topic>

    <frame_id>odom</frame_id>
    <child_frame_id>base_footprint</child_frame_id>

    <odom_publish_frequency>50</odom_publish_frequency>

    <max_linear_velocity>1.5</max_linear_velocity>
    <max_angular_velocity>1.5</max_angular_velocity>
  </plugin>

  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <topic>/joint_states</topic>
    <joint_name>left_wheel_joint</joint_name>
    <joint_name>right_wheel_joint</joint_name>
  </plugin>
</gazebo>

</robot>
